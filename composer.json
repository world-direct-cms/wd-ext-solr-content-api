{
  "name": "worlddirect/solr-content-api",
  "type": "typo3-cms-extension",
  "description": "Solr-backed file export API for TYPO3.",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": "^8.1",
    "typo3/cms-core": "^12.4 || ^13.4",
    "typo3/cms-frontend": "^12.4 || ^13.4",
    "apache-solr-for-typo3/solr": "^12.1"
  },
  "autoload": {
    "psr-4": {
      "WorldDirect\\SolrContentApi\\": "Classes/"
    }
  },
  "extra": {
    "typo3/cms": {
      "extension-key": "solr_content_api"
    }
  }
}
